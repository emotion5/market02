# 이 파일은 커밋된다. 실제 값은 .env 에 넣는다(.env 는 gitignore).
#
# DATABASE_URL: 앱 런타임 접속 URL. 서버리스(Vercel)면 커넥션 풀러 URL (Neon pooler 등)
# DIRECT_URL  : 마이그레이션·introspection 직결 URL (풀러 우회). 풀러 미사용 시 DATABASE_URL 과 동일.
DATABASE_URL="postgresql://user:password@host:5432/market02?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/market02?schema=public"

# 세션 JWT 서명 키 (긴 랜덤 문자열, 예: openssl rand -base64 32)
SESSION_SECRET="generate-a-long-random-string"

# Supabase Storage (S3 호환). Settings → Storage → S3 Access Keys 에서 발급.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_S3_ENDPOINT="https://<project-ref>.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="ap-northeast-1"
SUPABASE_S3_ACCESS_KEY_ID="<s3-access-key-id>"
SUPABASE_S3_SECRET_ACCESS_KEY="<s3-secret-access-key>"

# 토스페이먼츠 — 가상계좌 자동 입금확인. 개발자센터에서 발급(테스트 키는 test_ 접두).
# SECRET_KEY 는 서버 전용 비밀(결제 승인/조회). CLIENT_KEY 는 브라우저 결제창용(공개 가능).
TOSS_SECRET_KEY="test_sk_xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_ck_xxxxxxxxxxxxxxxxxxxxxxxx"

# 볼타(Bolta) — 전자세금계산서 정발행. BOLTA_MODE=mock 이면 키 없이 로컬 발행 흐름 검증.
# live 전환 시: 가입 후 API 키(test_/live_ 접두) + 공급자 등록으로 받은 Supplier-Key 필요.
BOLTA_MODE="mock"
BOLTA_API_KEY=""
BOLTA_SUPPLIER_KEY=""
# 공급자(우리 쇼핑몰) 고정 정보 — 값은 사업자등록증 기준으로 채운다(자리만 준비).
SHOP_BIZNO=""
SHOP_COMPANY=""
SHOP_OWNER=""
SHOP_MANAGER_NAME=""
SHOP_MANAGER_EMAIL=""

# 스윗트래커(SweetTracker) — 실시간 배송조회. MODE=mock 이면 키 없이 가짜 타임라인.
# live 전환 시: 발급 키를 넣고 MODE=live. 택배사는 관리자에서 목록으로 선택(lib/couriers.ts).
SWEETTRACKER_MODE="mock"
SWEETTRACKER_API_KEY=""
